# Replicate API Configuration
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Qdrant Configuration (Use your existing Qdrant cluster)
# For Qdrant Cloud: https://your-cluster.qdrant.io:6333
# For self-hosted: http://your-server:6333
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=your_collection_name_here

# Embedding Model Configuration
EMBEDDING_MODEL=beautyyuyanli/multilingual-e5-large:a06276a89f1a902d5fc225a9ca32b6e8e6292b7f3b136518878da97c458e2bad
EMBEDDING_DIMENSION=1024
BATCH_SIZE=32

# Text Splitting Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K_CANDIDATES=15
SCORE_THRESHOLD=0.7

# Generation Configuration
LLM_MODEL=meta/meta-llama-3-70b-instruct
TEMPERATURE=0.2
MAX_TOKENS=1000
TOP_P=0.9

# Dataset Configuration
DATASET_NAME=atitaarora/qdrant_doc
DATASET_SPLIT=train
